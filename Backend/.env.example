# Copy this to .env and fill in your values

# Database
DB_URL=jdbc:mysql://your-db-host:3306/sahilcrm_db?serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_user
DB_PASSWORD=your_strong_db_password

# JWT - generate with: openssl rand -base64 64
JWT_SECRET=your-minimum-64-character-random-string-here-replace-this-now
JWT_EXPIRATION_MS=3600000

# CORS - your deployed frontend URL
ALLOWED_ORIGIN=https://your-frontend-domain.com

# App profile (use 'prod' for production, 'dev' for local)
APP_PROFILE=prod

# DB schema management (use 'validate' in production)
DDL_AUTO=validate

# Seed passwords (dev profile only)
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_COUNSELOR_PASSWORD=
